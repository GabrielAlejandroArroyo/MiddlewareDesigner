# Copiar este archivo a .env y ajustar los valores.
# El archivo .env debe estar en esta carpeta (middleware/) al ejecutar el servidor.

# Tipo de autenticación: none | basic | database | oidc
# none = sin autenticación; basic = usuario/contraseña env; database = contra servicio Usuario; oidc = Keycloak (futuro)
# Recomendado: database para flujo completo (admin con cambio de contraseña obligatorio al primer login)
AUTH_TYPE=database

# Para usar credenciales fijas en variables de entorno: AUTH_TYPE=basic
# Servicio Usuario (solo cuando AUTH_TYPE=database)
USUARIO_SERVICE_URL=http://127.0.0.1:8007

# Usuario y contraseña para Basic Auth (solo cuando AUTH_TYPE=basic)
MIDDLEWARE_AUTH_USER=admin
MIDDLEWARE_AUTH_PASSWORD=admin

# Tiempo de sesión en minutos (desconexión automática tras X minutos desde el login). Default: 3
SESSION_TIMEOUT_MINUTES=3

# Tiempo de inactividad en minutos (logout automático si no hay interacción). 0 = deshabilitado. Default: 15
SESSION_INACTIVITY_MINUTES=15

# --- OIDC (Keycloak) - para uso futuro ---
# OIDC_ISSUER_URL=
# OIDC_AUDIENCE=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
